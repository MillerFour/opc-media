#!/usr/bin/env bash
# pre-commit：拦截明显不该入库的东西
# 1) 单个文件 > 30MB（本仓库是图文项目，超大二进制会让仓库不可收拾）
# 2) 临时文件 .tmp / .tmp-*
set -uo pipefail

LIMIT=$((30 * 1024 * 1024))
ERR=0

while IFS= read -r -d '' f; do
  [ -f "$f" ] || continue

  base=$(basename "$f")
  case "$base" in
    *.tmp|.tmp-*|*.log)
      echo "[pre-commit] 拒绝临时文件：$f" >&2
      ERR=1
      continue
      ;;
  esac

  size=$(stat -c%s "$f" 2>/dev/null || echo 0)
  if [ "$size" -gt "$LIMIT" ]; then
    mb=$((size / 1024 / 1024))
    echo "[pre-commit] 拒绝入库：$f（${mb}MB > 30MB）" >&2
    ERR=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "$ERR" -ne 0 ]; then
  echo "[pre-commit] 已阻止提交。确认要入库请手动 git add -f 并绕过钩子：git commit --no-verify" >&2
  exit 1
fi

exit 0
